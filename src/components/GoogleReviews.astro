---
import { googleProfile, googleReviews } from '../data/google-reviews';
---
<section class="google-reviews" id="opiniones" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="reviews-heading">
      <div>
        <p class="eyebrow">LA EXPERIENCIA DE NUESTROS CLIENTES</p>
        <h2 id="reviews-title">La confianza también<br/>se cuenta en primera persona.</h2>
        <p class="reviews-intro">Opiniones publicadas en la ficha de Google de Javier Chiva, el proyecto de diseño y desarrollo web del que nace nuestra experiencia digital.</p>
      </div>
      <a class="reviews-score" href={googleProfile.url} target="_blank" rel="noopener noreferrer" aria-label={`${googleProfile.rating} sobre 5, ${googleProfile.count} reseñas de Javier Chiva. Ver ficha en Google (nueva pestaña)`}>
        <span class="reviews-source">RESEÑAS EN GOOGLE <span aria-hidden="true">↗</span></span>
        <span class="reviews-number">{googleProfile.rating}<small>/ 5</small></span>
        <span class="reviews-stars" aria-hidden="true">★★★★★</span>
        <span>{googleProfile.count} reseñas · Javier Chiva</span>
      </a>
    </div>
    <div class="reviews-grid">
      {googleReviews.map(review => <figure class="review-card">
        <div class="review-top"><span class="reviews-stars" aria-label={`${review.rating} de 5 estrellas`}>★★★★★</span><span>Google</span></div>
        <blockquote><p>«{review.excerpt}»</p></blockquote>
        <figcaption><span class="review-avatar" aria-hidden="true">{review.initials}</span><span><strong>{review.author}</strong><small>Extracto de su reseña</small></span></figcaption>
      </figure>)}
    </div>
    <div class="reviews-footer">
      <p>Selección de opiniones sobre Javier Chiva. Valoración consultada el <time datetime={googleProfile.checkedAt}>{googleProfile.checkedLabel}</time>.</p>
      <a class="text-link" href={googleProfile.url} target="_blank" rel="noopener noreferrer">Ver la ficha y las reseñas en Google ↗</a>
    </div>
  </div>
</section>

<style>
  .google-reviews{padding:100px 0;background:#f4f4f9;color:#15161b}
  .reviews-heading{display:grid;grid-template-columns:minmax(0,1fr) 260px;align-items:center;gap:64px;margin-bottom:40px}
  .reviews-heading h2{font-size:clamp(2rem,3.8vw,3.8rem);max-width:850px;letter-spacing:-.055em;line-height:1.1;margin:16px 0 24px}
  .reviews-intro{max-width:660px;line-height:1.7;color:#616472}
  .reviews-score{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:28px;border:1px solid #dcdde8;border-radius:24px;color:inherit;text-decoration:none;background:#fff;transition:border-color .2s}
  .reviews-score:hover{border-color:#434dff}
  .reviews-source{display:flex;justify-content:space-between;gap:20px;width:100%;font-size:.68rem;letter-spacing:.08em;font-weight:700}
  .reviews-number{font-size:4.8rem;line-height:1.1;font-weight:600;letter-spacing:-.07em}
  .reviews-number small{font-size:1.1rem;letter-spacing:0;font-weight:400;margin-left:10px;color:#616472}
  .reviews-stars{color:#645000;letter-spacing:.13em}
  .reviews-score>span:last-child{font-size:.83rem;color:#616472}
  .reviews-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .review-card{display:flex;flex-direction:column;margin:0;padding:32px;background:white;border-radius:24px;min-width:0}
  .review-top{display:flex;align-items:center;justify-content:space-between;font-size:.85rem;color:#616472}
  blockquote{margin:32px 0;flex:1}
  blockquote p{margin:0;font-size:clamp(1.25rem,1.9vw,1.65rem);line-height:1.4;letter-spacing:-.025em}
  figcaption{display:flex;align-items:center;gap:12px}
  .review-avatar{width:42px;height:42px;flex-shrink:0;display:grid;place-items:center;border-radius:50%;background:#ebebff;color:#4341a2;font-size:.83rem;font-weight:700}
  figcaption strong{display:block;font-size:.85rem;line-height:1.4;font-weight:600}
  figcaption small{display:block;margin-top:4px;font-size:.75rem;color:#616472}
  .reviews-footer{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:28px}
  .reviews-footer p{max-width:590px;font-size:.75rem;line-height:1.6;color:#616472;margin:0}
  .reviews-footer a{font-size:.85rem;flex-shrink:0}
  @media(max-width:900px){.reviews-heading{gap:32px;grid-template-columns:minmax(0,1fr) 225px}.review-card{padding:24px}.reviews-footer{align-items:flex-start;flex-direction:column;gap:16px}}
  @media(max-width:680px){.google-reviews{padding:64px 0}.reviews-heading{grid-template-columns:1fr;gap:24px}.reviews-score{width:100%;box-sizing:border-box}.reviews-grid{grid-template-columns:1fr}blockquote{margin:24px 0}.reviews-footer a{flex-shrink:1}}
</style>
