---
import '../styles/journal.css';
import {journal,readingMinutes,type JournalPost} from '../data/journal';
interface Props {post:JournalPost}
const {post}=Astro.props;
const related=journal.filter(p=>p.slug!==post.slug);
const schema={'@context':'https://schema.org','@type':'BlogPosting',headline:post.title,description:post.description,author:{'@type':'Organization',name:'La Fábrica de Clientes',url:new URL('/sobre-nosotros/',Astro.site).href},publisher:{'@id':new URL('/#organization',Astro.site).href},image:new URL('/images/'+post.image,Astro.site).href,mainEntityOfPage:new URL('/blog/'+post.slug+'/',Astro.site).href,inLanguage:'es'};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)}/>
<header class="journal-article-hero"><div class="wrap"><div class="breadcrumbs"><a href="/">Inicio</a> / <a href="/blog/">Ideas para tu negocio</a></div><p class="eyebrow">{post.category}</p><h1>{post.title}</h1><p class="lead">{post.description}</p><div class="journal-byline"><a href="/sobre-nosotros/">La Fábrica de Clientes</a><span>Guía práctica</span><span>{readingMinutes(post)} min de lectura</span></div></div></header>
<div class="wrap journal-reading-layout"><aside class="journal-toc"><p class="eyebrow">EN ESTA GUÍA</p><ol>{post.sections.map((section,i)=><li><a href={'#lectura-'+(i+1)}>{section.title}</a></li>)}</ol><a class="text-link" href="/blog/">← Volver al blog</a></aside><article class="journal-body"><div class="journal-takeaway"><span>LA IDEA PRINCIPAL</span><p>{post.takeaway}</p></div><figure class="journal-cover"><img src={'/images/'+post.image} alt={post.alt} width="1000" height="700" fetchpriority="high"/><figcaption>Material del proyecto de {post.caseName}. Los ejemplos numéricos del artículo, cuando aparecen, son ilustrativos.</figcaption></figure>{post.sections.map((section,i)=><section id={'lectura-'+(i+1)}><span class="journal-section-index">{String(i+1).padStart(2,'0')}</span><h2>{section.title}</h2><div set:html={section.html}/></section>)}<aside class="journal-case"><p class="eyebrow">DEL ARTÍCULO AL PROYECTO</p><h2>{post.caseName}</h2><p>{post.caseText}</p><a class="text-link" href={'/casos-reales/'+post.caseSlug+'/'}>Explorar el caso real ↗</a></aside><section class="journal-sources"><h2>Fuentes y contexto</h2><p>Esta guía combina recomendaciones prácticas con actuaciones documentadas en los proyectos enlazados. No atribuye resultados comerciales que no estén acreditados.</p><ul>{post.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}</ul></section><div class="journal-publisher"><span class="publisher-symbol" aria-hidden="true">↗</span><div><strong>La Fábrica de Clientes</strong><p>Captación, web y seguimiento comercial desde la experiencia de gestionar negocios propios y trabajar en proyectos de clientes.</p><a href="/sobre-nosotros/">Conoce quién está detrás →</a></div></div></article></div>
<section class="wrap journal-cta"><div><p class="eyebrow">APLIQUÉMOSLO A TU EMPRESA</p><h2>¿Te reconoces<br/>en esta situación?</h2><p>Cuéntanos qué está pasando y valoremos qué merece la pena revisar.</p></div><div><a class="button" href="/contacto/">Hablemos de tu negocio ↗</a><a class="text-link" href={post.service}>{post.serviceName} →</a></div></section><section class="wrap section journal-related"><p class="eyebrow">SIGUE LEYENDO</p><h2>Otra perspectiva para decidir.</h2><div class="journal-grid-two">{related.map(item=><a class="journal-card" href={'/blog/'+item.slug+'/'}><p class="eyebrow">{item.category}</p><h3>{item.title}</h3><p>{item.description}</p><span>{readingMinutes(item)} min de lectura <b aria-hidden="true">↗</b></span></a>)}</div></section>
