---
import Layout from '../layouts/Layout.astro';
import '../styles/interiors.css';
import {cases} from '../data/pages';
import {caseDetails} from '../data/case-details';
const photos: Record<string,string> = {"ecoherbes":"ecoherbes.jpg","bon-mares-asesores":"bon-mares.jpg","blaze-media":"blaze-media.png","clinica-ergoterapia":"ergoterapia.jpg",'reparatec':'reparatec-proyecto.jpeg','electrica-levante':'proyecto-electrica-levante.png','javier-chiva':'trabajo-software.jpg','confrio':'confrio-web.jpg','suboney':'proyecto-siboney.jpg'};
---
<Layout title="Casos reales · Negocios propios y clientes" description="Proyectos reales de captación, ecommerce, SEO y diseño web: Reparatec, Confrio, Ecoherbes, Siboney, Bon & Mares y más."><section class="page-hero"><div class="wrap"><div class="breadcrumbs"><a href="/">Inicio</a> / Casos reales</div><p class="eyebrow">EXPERIENCIA QUE PUEDES CONOCER</p><h1>Negocios propios.<br/>Proyectos compartidos.</h1><p class="lead">Del negocio al trabajo concreto: webs, tiendas online, posicionamiento y campañas. Explora los objetivos, las decisiones y las imágenes de cada proyecto.</p></div></section><section class="wrap section">{['Negocio propio','Cliente'].map(type=><div class="case-directory-group"><h2>{type==='Cliente'?'Empresas a las que hemos ayudado.':'Los negocios que gestionamos.'}</h2><div class="directory-grid">{cases.filter(item=>item.type===type).map(item=>{const detail=caseDetails[item.slug as keyof typeof caseDetails];return <a class="directory-card" href={'/casos-reales/'+item.slug+'/'}><img class="directory-photo" src={'/images/'+photos[item.slug]} alt={'Imagen del proyecto '+item.name} width="768" height="450" loading="lazy"/><p class="eyebrow">{item.type}</p><h3>{item.name}</h3><p class="case-focus">{detail.focus}</p><p>{detail.intro}</p><span class="text-link">Explorar proyecto →</span></a>})}</div></div>)}</section><section class="wrap inner-closing"><div><p class="eyebrow">APLIQUEMOS LA EXPERIENCIA</p><h2>Hablemos de tu situación.</h2><p>El punto de partida de cada empresa es distinto. Veamos qué necesitas mejorar.</p></div><a class="button" href="/contacto/">Cuéntanos tu proyecto ↗</a></section></Layout>
