---
import Layout from '../layouts/Layout.astro';
import ContactLocation from '../components/ContactLocation.astro';
---
<Layout><section class="hero"><div class="wrap"><div class="hero-topline"><p class="eyebrow">ESTRATEGIA. EJECUCIÓN. CLIENTES.</p><span class="hero-note">PARA EMPRESAS<br/>QUE QUIEREN AVANZAR</span></div><h1>Buen negocio.<br/><span class="hero-last">Más <em>clientes.</em><a href="/contacto/" class="hero-arrow" aria-label="Hablemos de tu empresa">↗</a></span></h1><section class="hero-photo hero-carousel" aria-label="Nuestro trabajo en imágenes" aria-roledescription="carrusel"><div class="hero-slides"><img class="hero-slide active" src="/images/javier-trabajando.jpg" alt="Sesión de trabajo junto a dos portátiles" width="1000" height="700" fetchpriority="high"/><img class="hero-slide" src="/images/trabajo-web.jpg" alt="Reunión para revisar un proyecto" width="900" height="450" aria-hidden="true"/><img class="hero-slide" src="/images/trabajo-software.jpg" alt="Desarrollo web y revisión de la experiencia en móvil" width="900" height="450" aria-hidden="true"/></div><div class="carousel-caption"><span>PERSONAS DETRÁS DE CADA DECISIÓN</span><a href="/sobre-nosotros/">Conócenos ↗</a></div><div class="carousel-controls" hidden><button type="button" data-prev aria-label="Fotografía anterior">←</button><span class="carousel-count" aria-live="off">01 / 03</span><button type="button" data-next aria-label="Fotografía siguiente">→</button><button type="button" data-pause aria-label="Pausar carrusel">Ⅱ</button></div></section><div class="hero-bottom"><p class="lead">Tu empresa tiene mucho que ofrecer.<br/>Hagamos que los clientes adecuados lo sepan.</p><div><a class="button" href="/contacto/">Activemos tu captación <span>↗</span></a><p class="micro">Desde 10.000 € · Colaboración continua</p></div></div><div class="hero-system"><span class="system-label">DEL NEGOCIO<br/>A LA OPORTUNIDAD</span><div><b>01</b><span>Estrategia</span></div><span class="system-arrow">→</span><div><b>02</b><span>Web + SEO + Ads</span></div><span class="system-arrow">→</span><div><b>03</b><span>Clientes potenciales</span></div><span class="system-arrow">→</span><div><b>04</b><span>Mejora continua</span></div></div></div></section><section class="proof-strip"><div class="wrap"><p>EXPERIENCIA EN NEGOCIOS PROPIOS Y CLIENTES</p><div class="names"><a href="/casos-reales/reparatec/">reparatec<span>NEGOCIO PROPIO</span></a><a href="/casos-reales/electrica-levante/">eléctrica levante<span>NEGOCIO PROPIO</span></a><a href="/casos-reales/javier-chiva/">JAVIER CHIVA<span>NEGOCIO PROPIO</span></a><a href="/casos-reales/confrio/">confrio<span>CLIENTE</span></a><a href="/casos-reales/suboney/">Siboney<span>CLIENTE</span></a></div></div></section><section class="section wrap"><div class="section-heading"><div><p class="eyebrow">EL PUNTO DE PARTIDA</p><h2>Hay un buen negocio.<br/>Falta que lo encuentren.</h2></div><p>Si tu empresa tiene capacidad para crecer, la captación necesita una dirección clara y alguien que se implique en llevarla a la práctica.</p></div><div class="three-grid"><article class="plain-card photo-card"><img class="problem-photo" src="/images/trabajo-web.jpg" alt="Reunión de trabajo para conocer las necesidades del negocio" width="900" height="450" loading="lazy"/><span class="index">01 / DEPENDENCIA</span><h3>El boca a boca ya no es suficiente.</h3><p>Necesitas abrir nuevas vías de entrada sin depender únicamente de las recomendaciones.</p></article><article class="plain-card photo-card"><img class="problem-photo" src="/images/javier-trabajando.jpg" alt="Revisión conjunta de un proyecto junto a dos portátiles" width="1000" height="700" loading="lazy"/><span class="index">02 / CALIDAD</span><h3>Hay consultas, pero no encajan.</h3><p>Quieres llegar a quienes necesitan los servicios que realmente interesa vender a tu empresa.</p></article><article class="plain-card photo-card"><img class="problem-photo" src="/images/trabajo-software.jpg" alt="Revisión de una web en ordenador y móvil" width="900" height="450" loading="lazy"/><span class="index">03 / CONTROL</span><h3>Inviertes sin ver el recorrido.</h3><p>Necesitas conectar la inversión con consultas, presupuestos y oportunidades comerciales.</p></article></div></section><section class="blue-section"><div class="wrap"><p class="eyebrow">CÓMO TE AYUDAMOS</p><div class="section-heading"><h2>De entender tu negocio<br/>a activar su captación.</h2><a class="text-link light" href="/captacion-de-clientes/">Conoce la propuesta →</a></div><div class="service-list">{[['01','Estrategia de captación','Qué vender, a quién y dónde. Prioridades antes de empezar.','/captacion-de-clientes/'],['02','Web que facilita el contacto','Una propuesta clara y razones para elegir tu empresa.','/servicios/diseno-web/'],['03','SEO y publicidad','Llegar a personas que están buscando tus servicios.','/servicios/posicionamiento-seo/'],['04','Seguimiento y mejora','Entender qué llega y qué sucede después.','/como-trabajamos/']].map(([n,t,d,u])=><a href={u}><span>{n}</span><h3>{t}</h3><p>{d}</p><span class="arrow">↗</span></a>)}</div></div></section><section class="section wrap"><div class="section-heading"><div><p class="eyebrow">EXPERIENCIA REAL</p><h2>También estamos<br/>al otro lado del negocio.</h2></div><p>Gestionamos negocios propios y ayudamos a otras empresas. Esa experiencia guía nuestra forma de decidir, invertir y trabajar.</p></div><div class="case-grid"><a class="case-card" href="/casos-reales/electrica-levante/"><div class="case-art project-image"><img src="/images/proyecto-electrica-levante.png" alt="Web de Eléctrica Levante: servicios eléctricos en Valencia" width="768" height="386" loading="lazy"/></div><div class="case-info"><span class="eyebrow">NEGOCIO PROPIO</span><h3>Eléctrica Levante <span>↗</span></h3><p>La perspectiva de quien gestiona su propio negocio.</p></div></a><a class="case-card" href="/casos-reales/confrio/"><div class="case-art pale project-image"><img src="/images/confrio-web.jpg" alt="Web de Confrio con su catálogo de refrigeración profesional" width="1000" height="700" loading="lazy"/></div><div class="case-info"><span class="eyebrow">CLIENTE</span><h3>Confrio <span>↗</span></h3><p>Experiencia aplicada a otra empresa en funcionamiento.</p></div></a></div><a class="text-link" href="/casos-reales/">Conoce todos los negocios →</a></section><section class="people-section wrap"><figure><img src="/images/trabajo-web.jpg" alt="Reunión de trabajo publicada en Javier Chiva" width="900" height="450" loading="lazy"/><figcaption>Javier Chiva · Dirección del proyecto</figcaption></figure><div><p class="eyebrow">HABLEMOS DE PERSONA A PERSONA</p><h2>Tu negocio merece<br/>que alguien se implique.</h2><p class="lead">Escuchar, entender lo que necesitas y trabajar contigo. Así empieza una relación que va más allá del lanzamiento de una web.</p><a class="text-link" href="/sobre-nosotros/">Conoce quién está detrás →</a></div></section><section class="fit-section"><div class="wrap two-grid"><div><p class="eyebrow">PARA EMPRESAS QUE QUIEREN DAR EL PASO</p><h2>Tu negocio ya existe.<br/>Construyamos<br/>su siguiente etapa.</h2></div><div><p class="lead">Trabajamos con pequeñas empresas con una oferta consolidada, capacidad para atender más clientes y dirección implicada.</p><ul class="check-list"><li>Una empresa en funcionamiento.</li><li>Inversión mínima de 10.000 €.</li><li>Una relación de trabajo continua.</li><li>Acceso a información para decidir mejor.</li></ul><a class="button" href="/contacto/">Valoremos si encajamos ↗</a></div></div></section><section class="section wrap"><p class="eyebrow">ANTES DE HABLAR</p><h2>Preguntas que importan.</h2><div class="faq">{[['¿Tenemos que cambiar nuestra web?','Solo si es necesario. Primero revisamos lo que ya tienes y decidimos qué conservar, mejorar o reconstruir.'],['¿Qué incluye la inversión?','El alcance se define tras conocer el negocio. La propuesta separa puesta en marcha, acompañamiento y presupuesto publicitario para que sepas qué cubre cada partida.'],['¿Garantizáis ventas?','No podemos garantizar una venta: también intervienen la oferta, los precios, la disponibilidad y la atención de tu empresa. Trabajamos sobre la captación y revisamos contigo la calidad de las oportunidades.'],['¿Podéis trabajar con nuestro equipo?','Sí. La colaboración con la dirección y las personas que atienden las consultas es parte del trabajo.']].map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section><section class="closing wrap"><p class="eyebrow">HABLEMOS DE NEGOCIO</p><h2>¿Qué necesita<br/>tu empresa para crecer?</h2><a class="button" href="/contacto/">Cuéntanos tu situación ↗</a></section><ContactLocation /></Layout>

<script>
const carousel=document.querySelector<HTMLElement>('.hero-carousel');
if(carousel){
 const slides=Array.from(carousel.querySelectorAll<HTMLImageElement>('.hero-slide'));
 const count=carousel.querySelector<HTMLElement>('.carousel-count')!;
 const pause=carousel.querySelector<HTMLButtonElement>('[data-pause]')!;
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
 let current=0,paused=reduced.matches,hovered=false,timer:ReturnType<typeof setInterval>|undefined;
 carousel.querySelector<HTMLElement>('.carousel-controls')!.hidden=false;
 const show=(index:number)=>{current=(index+slides.length)%slides.length;slides.forEach((slide,i)=>{slide.classList.toggle('active',i===current);slide.setAttribute('aria-hidden',String(i!==current))});count.textContent=`${String(current+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`};
 const sync=()=>{clearInterval(timer);pause.textContent=paused?'▶':'Ⅱ';pause.setAttribute('aria-label',paused?'Reanudar carrusel':'Pausar carrusel');if(!paused&&!hovered&&!document.hidden)timer=setInterval(()=>show(current+1),5000)};
 carousel.querySelector('[data-next]')?.addEventListener('click',()=>{show(current+1);sync()});
 carousel.querySelector('[data-prev]')?.addEventListener('click',()=>{show(current-1);sync()});
 pause.addEventListener('click',()=>{paused=!paused;sync()});
 carousel.addEventListener('mouseenter',()=>{hovered=true;sync()});
 carousel.addEventListener('mouseleave',()=>{hovered=false;sync()});
 carousel.addEventListener('focusin',e=>{if(e.target!==pause){paused=true;sync()}});
 carousel.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();show(current+(e.key==='ArrowRight'?1:-1));sync()}});
 document.addEventListener('visibilitychange',sync);
 reduced.addEventListener('change',()=>{paused=reduced.matches;sync()});
 sync();
}
</script>
