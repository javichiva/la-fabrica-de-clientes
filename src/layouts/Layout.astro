---
import '../styles/global.css';
const {title='Captación de clientes para pymes',description='Estrategia y ejecución para captar clientes. Ayudamos a empresas en funcionamiento con web, SEO, publicidad y seguimiento comercial.', noindex=false,ogImage='/images/javier-trabajando.jpg',ogType='website'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const origin=Astro.site!;
const schemaOrg={'@context':'https://schema.org','@type':'Organization','@id':new URL('/#organization',origin).href,name:'La Fábrica de Clientes',email:'info@javierchiva.com',telephone:'+34662434611',address:{'@type':'PostalAddress',streetAddress:'C/ de Carles Cervera, 14',postalCode:'46006',addressLocality:'València',addressCountry:'ES'},url:origin.href,logo:new URL('/images/logo.png',origin).href};
const pathParts=Astro.url.pathname.split('/').filter(Boolean);
const sectionNames:Record<string,string>={'servicios':'Servicios','sectores':'Sectores','casos-reales':'Casos reales','blog':'Blog'};
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:origin.href},...pathParts.map((part,i)=>({'@type':'ListItem',position:i+2,name:i===pathParts.length-1?title:(sectionNames[part]||part),item:new URL('/'+pathParts.slice(0,i+1).join('/')+'/',origin).href}))]};
const nav=[['Sectores','/sectores/'],['Casos reales','/casos-reales/'],['Nosotros','/sobre-nosotros/'],['Blog','/blog/']];
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="google-site-verification" content="NFtOwnJo7y2pZmwgaGQcxsxP_wAAM1hN98CAt5dx7Tg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><meta name="viewport" content="width=device-width"/><title>{title} | La Fábrica de Clientes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={ogType}/><meta property="og:image" content={new URL(ogImage,Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><meta property="og:url" content={canonical}/><meta property="og:locale" content="es_ES"/><meta property="og:site_name" content="La Fábrica de Clientes"/><script type="application/ld+json" set:html={JSON.stringify(schemaOrg)}/>{pathParts.length>0&&!noindex&&<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}/>}</head><body><a class="skip" href="#contenido">Saltar al contenido</a><header class="header"><a class="brand" href="/" aria-label="La Fábrica de Clientes, inicio"><img src="/images/logo.png" width="2048" height="333" alt="La Fábrica de Clientes"/></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menú <span>☰</span></button><nav id="navigation" aria-label="Principal"><details class="services-dropdown"><summary class:list={{'services-active':Astro.url.pathname.startsWith('/servicios/')||Astro.url.pathname==='/captacion-de-clientes/'}}>Servicios <span aria-hidden="true">⌄</span></summary><div class="services-dropdown-panel"><p>ESTRATEGIA Y EJECUCIÓN</p>{[['Captación de clientes','Una dirección para todo el conjunto.','/captacion-de-clientes/'],['Posicionamiento SEO','Visibilidad para tus servicios.','/servicios/posicionamiento-seo/'],['Google Ads','Campañas con criterio comercial.','/servicios/google-ads/'],['Diseño web','Claridad, confianza y contacto.','/servicios/diseno-web/']].map(([name,description,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}><span>{name} <b aria-hidden="true">↗</b></span><small>{description}</small></a>)}<a class="all-services" href="/servicios/">Ver todos los servicios →</a></div></details>{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}<a class="button small" href="/contacto/">Hablemos de tu empresa <span>↗</span></a></nav></header><main id="contenido"><slot/></main><footer><div class="footer-top"><a class="brand" href="/"><img src="/images/logo.png" width="2048" height="333" alt="La Fábrica de Clientes" loading="lazy"/></a><p>Estrategia y ejecución<br/>para captar clientes.</p></div><div class="footer-grid"><div><h3>Tu próximo paso</h3><a class="footer-link" href="/contacto/">Hablemos de tu empresa ↗</a><a href="mailto:info@javierchiva.com">info@javierchiva.com</a><a href="tel:+34662434611">662 434 611</a><a href="https://www.google.com/maps?q=C%2F%20de%20Carles%20Cervera%2C%2014%2C%2046006%20Valencia" target="_blank" rel="noopener noreferrer">C/ de Carles Cervera, 14<br/>46006 València, Valencia</a><p>Empresas en funcionamiento.<br/>Colaboración continua.</p></div><div><h3>Cómo te ayudamos</h3><a href="/servicios/">Todos los servicios</a><a href="/sectores/">Sectores</a><a href="/captacion-de-clientes/">Captación de clientes</a><a href="/servicios/posicionamiento-seo/">Posicionamiento SEO</a><a href="/servicios/google-ads/">Google Ads</a><a href="/servicios/diseno-web/">Diseño web</a></div><div><h3>Conócenos</h3><a href="/casos-reales/">Casos reales</a><a href="/como-trabajamos/">Cómo trabajamos</a><a href="/sobre-nosotros/">Nosotros</a><a href="/blog/">Ideas para tu negocio</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} La Fábrica de Clientes</span><a href="https://www.lafabricadeclientes.es/aviso-legal/">Aviso legal</a><a href="https://www.lafabricadeclientes.es/politica-privacidad/">Privacidad</a></div></footer><script>const toggle=document.querySelector('.menu-toggle');const nav=document.querySelector('#navigation');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open)});document.addEventListener('keydown',e=>{if(e.key==='Escape' && !document.querySelector('.services-dropdown[open]')){toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('open')}});const services=document.querySelector<HTMLDetailsElement>('.services-dropdown');document.addEventListener('click',e=>{if(services && e.target instanceof Node && !services.contains(e.target))services.open=false});document.addEventListener('keydown',e=>{if(e.key==='Escape' && services?.open){services.open=false;services.querySelector('summary')?.focus()}});services?.addEventListener('focusout',e=>{if(e.relatedTarget instanceof Node && !services.contains(e.relatedTarget))services.open=false});toggle?.addEventListener('click',()=>{if(toggle.getAttribute('aria-expanded')==='false' && services)services.open=false});if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('motion');const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.08});document.querySelectorAll('.section-heading,.plain-card,.case-card,.directory-card,.article-content section').forEach(el=>{el.classList.add('reveal');observer.observe(el)})}</script></body></html>
